/* Basic page setup */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #111;
    font-family: Arial, Helvetica, sans-serif;
    display: flex;
    justify-content: center;
    padding: 25px 10px;
}

/* Main poster */
.poster {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 2 / 3;
    position: relative;
    overflow: hidden;
    color: white;

    background-image:
        linear-gradient(
            to bottom,
            transparent 45%,
            rgba(0, 0, 0, 0.10) 55%,
            rgba(0, 0, 0, 0.80) 100%
        ),
        url("images/creed-background.jpg");

    background-size: cover;
    background-position: center;
}

/* Actor names in the centre */
.actor-names {
    position: absolute;
    top: 48.5%;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    text-align: center;
    font-family: Impact, "Arial Narrow", sans-serif;
    font-size: clamp(12px, 2.5vw, 17px);
    font-weight: bold;
    line-height: 0.95;
    letter-spacing: 1px;
    text-shadow: 1px 2px 3px #222;
}

.actor-names p {
    margin-bottom: 17px;
}

.actor-names span {
    display: block;
    font-size: 0.65em;
    margin-bottom: 3px;
    letter-spacing: 1px;
}

/* Movie title */
.movie-information {
    position: absolute;
    top: 64%;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    text-align: center;
    text-shadow: 2px 2px 5px black;
}

.movie-title {
    position: relative;
    display: inline-block;
    font-family: Impact, "Arial Narrow", sans-serif;
    font-size: clamp(65px, 15vw, 105px);
    line-height: 0.95;
    letter-spacing: -3px;
    font-weight: 900;
}

.title-letters {
    position: relative;
    z-index: 2;
    color: white;
}

.roman-numeral {
    position: absolute;
    z-index: 1;
    color: #e00016;
    font-size: 0.95em;
    letter-spacing: -8px;
    left: 50%;
    top: -10%;
    transform: translateX(-50%);
    opacity: 0.95;
}

/* Cinema release information */
.cinema-text {
    font-size: clamp(14px, 3vw, 19px);
    font-weight: 900;
    margin-top: 8px;
    letter-spacing: 1px;
}

.release-month {
    font-family: Impact, "Arial Narrow", sans-serif;
    font-size: clamp(29px, 6vw, 43px);
    font-weight: bold;
    line-height: 1;
    letter-spacing: 1px;
}

/* Tagline */
.tagline {
    position: absolute;
    top: 79%;
    left: 0;
    width: 100%;
    text-align: center;
    padding: 0 8px;
    text-shadow: 2px 2px 4px black;
}

.tagline h2 {
    font-family: Impact, "Arial Narrow", sans-serif;
    font-size: clamp(15px, 3.5vw, 23px);
    letter-spacing: 1px;
}

/* Movie credits */
.movie-credits {
    position: absolute;
    bottom: 3%;
    left: 5%;
    width: 90%;
    text-align: center;
    color: #bcbcbc;
    text-shadow: 1px 1px 2px black;
}

.credit-paragraph {
    font-family: "Arial Narrow", Arial, sans-serif;
    font-size: clamp(4px, 1vw, 6px);
    line-height: 1.5;
    letter-spacing: 0.1px;
    margin-bottom: 3px;
}

/* Studio names */
.studio-logos {
    display: flex;
    align-items: center;
    justify-content: space-around;
    margin-top: 10px;
    color: #bcbcbc;
    font-weight: bold;
}

.mgm {
    font-family: Georgia, serif;
    font-size: 19px;
}

.imax {
    font-size: 21px;
    font-weight: 900;
    font-style: italic;
}

.warner {
    font-size: 8px;
    letter-spacing: 1px;
}

/* Smaller screens */
@media (max-width: 450px) {
    body {
        padding: 10px 5px;
    }

    .actor-names p {
        margin-bottom: 12px;
    }

    .movie-credits {
        bottom: 2%;
    }
}